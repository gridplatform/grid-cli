{
  "name": "@gridplatform/grid-cli",
  "version": "0.1.0",
  "description": "Grid Platform CLI - Command-line interface for Infrastructure Orchestration",
  "main": "dist/index.js",
  "bin": {
    "grid": "./bin/grid.js"
  },
  "scripts": {
    "grid": "GRID_APP_ENV=development node ./bin/grid.js",
    "dev": "GRID_APP_ENV=development tsx watch src/index.ts",
    "prod": "GRID_APP_ENV=production npm run build && GRID_APP_ENV=production node ./bin/grid.js",
    "build": "tsc",
    "start": "GRID_APP_ENV=production node ./bin/grid.js",
    "start:prod": "GRID_APP_ENV=production node ./bin/grid.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "infrastructure",
    "orchestration",
    "devops",
    "terraform",
    "opentofu",
    "cli",
    "iac"
  ],
  "author": "Grid Platform Team <team@gridplatform.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gridplatform/grid-cli.git"
  },
  "bugs": {
    "url": "https://github.com/gridplatform/grid-cli/issues"
  },
  "homepage": "https://github.com/gridplatform/grid-cli#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "zod": "^3.22.4",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1",
    "fs-extra": "^11.2.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.1",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
