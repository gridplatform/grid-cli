# Optional standalone CLI env.
# Prefer `npm run dev` / `npm run grid` with `.env.development` for local work.
#
# Production: grid-core owns the hard config gate and injects GRID_* when it
# spawns the CLI. You usually do not need a production `.env` in this package.
# Incomplete remote-state settings still fail at generate time (backend.tf).

# GRID_CONFIG_ROOT=../grid-config
# GRID_MODULE_BANK=../grid-terraform
# GRID_MODULE_BANK_REF=main
# GRID_MODULE_SOURCE=link
